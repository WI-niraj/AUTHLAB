{
  "name": "authlab-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env --import tsx server.ts",
    "migrate": "node --env-file=.env --import tsx src/db/migrate.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}